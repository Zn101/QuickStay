# ============================================================
# backend/.dockerignore – T134
# Loai tru file khong can thiet khoi Docker build context.
# Giam kich thuoc context, tang toc build, tranh lo secret.
# ============================================================

# Build output (Gradle tu build trong container, khong can output cu tren host)
build/
.gradle/
out/

# File moi truong – TUYET DOI khong copy vao image
.env
.env.*
!.env.example

# IDE va OS
.idea/
*.iml
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Tai lieu
*.md
docs/

# Log
*.log

# Docker
Dockerfile
.dockerignore

# NOTE: src/test/ KHONG bi loai tru vi Dockerfile build bang "-x test"
# (Gradle skip test khi build JAR), nhung test files khong can thiet trong image.
# Neu muon loai tru test de giam context size, bo comment dong duoi:
# src/test/
