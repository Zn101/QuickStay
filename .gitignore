# ============================================================
# QuickStay — .gitignore
# ============================================================

# ─── Secrets & Environment ───────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ─── Frontend ────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.vitest-cache/

# ─── Backend ─────────────────────────────────────────────────
backend/build/
backend/.gradle/
backend/out/
*.jar
!backend/gradle/wrapper/gradle-wrapper.jar

# ─── IDE & Editor ────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Test & Coverage ─────────────────────────────────────────
coverage/
.nyc_output/
test-results/
*.lcov

# ─── Docker ──────────────────────────────────────────────────
# (docker-compose.yml is tracked; local overrides are not)
docker-compose.override.yml

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
