# =============================================================
# QuickStay – Environment Variables Template
# =============================================================
# Sao chep file nay thanh .env roi dien gia tri that.
# TUYET DOI khong commit file .env len Git.
# Tat ca gia tri duoi day la MAU DE PHAT TRIEN (development defaults).
# PHAI THAY THE bang gia tri ngau nhien, du manh truoc khi deploy len production.
#
# docker-compose.prod.yml KHONG khoi dong neu thieu: DB_PASSWORD, DB_ROOT_PASSWORD,
# JWT_SECRET, ADMIN_PASSWORD.
# =============================================================

# --- Database (BAT BUOC tren production) ---
# Thay bang mat khau du manh (toi thieu 20 ky tu ngau nhien): openssl rand -hex 20
DB_PASSWORD=quickstay_pw
DB_ROOT_PASSWORD=root_pw

# --- JWT (BAT BUOC tren production) ---
# Toi thieu 32 ky tu ngau nhien: openssl rand -base64 48
# Doi JWT_SECRET se dang xuat toan bo nguoi dung dang dang nhap.
JWT_SECRET=doi-chuoi-nay-toi-thieu-32-ky-tu-ngau-nhien

# --- Admin account (ADMIN_PASSWORD BAT BUOC tren production) ---
# Chi dung khi tao admin LAN DAU (DB chua co email nay). Doi gia tri sau do KHONG doi mat khau
# cua admin da ton tai: hay doi trong trang Ho so.
ADMIN_EMAIL=admin@quickstay.local
ADMIN_PASSWORD=Admin@123

# --- CORS ---
# Domain frontend that tren production, cach nhau bang dau phay
CORS_ORIGINS=http://localhost:8081

# --- Du lieu mau ---
# true: tao khach san mau (khi bang hotels trong) va cac tai khoan doi tac mau
#       (homestay@, partner@, restaurant@, tour@ ...quickstay.local) – mat khau cong khai trong code.
# false: khong tao gi. docker-compose.prod.yml mac dinh false; docker-compose.yml (dev) mac dinh true.
# Nha hang & tour mau luon co (nam trong migration V8), khong phu thuoc bien nay.
SEED_SAMPLE_DATA=false

# --- Xac thuc email ---
# true (mac dinh): dat phong, dat ban, dat tour, danh gia, dat dich vu yeu cau email da xac thuc.
# Khi khong cau hinh SMTP, khach xem email xac thuc trong "Hop thu" tren web.
REQUIRE_VERIFIED_EMAIL=true

# --- Mui gio nghiep vu ---
# Quyet dinh "hom nay" khi kiem tra ngay nhan phong / dat ban / dat tour
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Anthropic AI (tuy chon) ---
# De trong thi chatbot dung che do du phong dua tren CSDL, khong loi
# Lay tai: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Gioi han goi AI (bao ve chi phi API): moi nguoi dung / IP moi phut, moi ngay, va tran toan he thong moi ngay
AI_RATE_PER_MINUTE=25
AI_PER_CLIENT_DAILY_CAP=200
AI_DAILY_REQUEST_CAP=5000

# --- Ports (tuy chon) ---
#FRONTEND_PORT=8081

# --- Frontend URL & Email ---
# FRONTEND_URL dung de tao link trong email (xac thuc, dat lai mat khau)
FRONTEND_URL=http://localhost:8081
# De trong MAIL_HOST: che do mo phong, email chi luu trong "Hop thu" tren web.
# Co MAIL_HOST: gui SMTP that; ma xac thuc / ma khoi phuc trong hop thu web bi che.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@quickstay.io.vn
