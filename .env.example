# =============================================================
# QuickStay – Environment Variables Template (T069)
# =============================================================
# Sao chep file nay thanh .env roi dien gia tri that.
# TUYET DOI khong commit file .env len Git.
# Tat ca gia tri duoi day la MAU DE PHAT TRIEN (development defaults).
# PHAI THAY THE bang gia tri ngau nhien, du manh truoc khi deploy len production.
# =============================================================

# --- Database ---
# Thay bang mat khau du manh tren production (toi thieu 20 ky tu ngau nhien)
DB_PASSWORD=quickstay_pw
DB_ROOT_PASSWORD=root_pw

# --- JWT ---
# PHAI THAY: toi thieu 32 ky tu ngau nhien, nen dung: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-toi-thieu-32-ky-tu-ngau-nhien

# --- Admin account mac dinh ---
# PHAI THAY ADMIN_PASSWORD truoc khi chay production
ADMIN_EMAIL=admin@quickstay.local
ADMIN_PASSWORD=Admin@123

# --- CORS ---
# Thay bang domain frontend that tren production
CORS_ORIGINS=http://localhost:8081

# --- Anthropic AI (tuy chon) ---
# De trong thi chatbot dung che do du phong, khong loi
# Lay tai: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Ports (tuy chon, bo comment neu bi trung cong) ---
#BACKEND_PORT=8080
#FRONTEND_PORT=8081
